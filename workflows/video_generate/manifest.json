    "height": {"node": "3", "field": "height"},
    "frames": {"node": "3", "field": "batch_size"},
    "seed": {"node": "5", "field": "seed"},
    "steps": {"node": "5", "field": "steps"},
    "fps": {"node": "7", "field": "fps"}
  },
  "asset_inputs": {},
