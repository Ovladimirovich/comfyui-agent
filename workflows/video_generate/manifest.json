    "frames": {"default": 4, "min": 1, "max": 16},
    "width": {"default": 512, "min": 64, "max": 1024},
    "height": {"default": 512, "min": 64, "max": 1024},
    "seed": {"default": 0, "min": 0, "max": 4294967295},
    "steps": {"default": 20, "min": 1, "max": 60}
  },
  "required_models": ["checkpoint"],
  "required_custom_nodes": ["CreateVideo", "SaveVideo"],
  "min_comfyui_version": "0.0.0",
